# File Toolkit — 行尾规范
# 统一使用 LF，.bat 文件使用 CRLF（Windows CMD 要求）
* text=auto eol=lf
*.bat text eol=crlf
*.py text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
# 二进制文件
*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.xmind binary
